{
  "name": "wave-riders",
  "version": "0.1.0",
  "type": "module",
  "description": "Wave Riders: a kids' boat-racing game (jet skis, speedboats, sailboats, pontoons) on the ABYSSAL procedural ocean, with portals into calm, swell and storm worlds.",
  "license": "MIT",
  "author": "Davi (Token-Gremlin) <https://github.com/Token-Gremlin>",
  "homepage": "https://github.com/emollick/abyssal-living-deep#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emollick/abyssal-living-deep.git"
  },
  "bugs": {
    "url": "https://github.com/emollick/abyssal-living-deep/issues"
  },
  "keywords": [
    "threejs",
    "webgl2",
    "boat-racing",
    "kids-game",
    "fft-ocean",
    "procedural-generation",
    "glsl",
    "shaders",
    "ocean",
    "water-simulation",
    "volumetric-clouds",
    "atmospheric-scattering",
    "raymarching",
    "weather-simulation",
    "natural-disasters",
    "tsunami",
    "hurricane",
    "post-processing",
    "taa",
    "pbr",
    "real-time-rendering",
    "cinematic"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node tools/quality-sim.mjs && node tools/underwater-sim.mjs && node tools/connected-ocean-sim.mjs && node tools/fauna-sim.mjs && node tools/animal-motion-sim.mjs && node tools/biome-sim.mjs",
    "smoke": "node tools/smoke.mjs",
    "game-smoke": "node tools/game-smoke.mjs --gpu",
    "test:game": "node tools/check-worlds.mjs && node tools/game-smoke.mjs --gpu --seconds 10"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "puppeteer": "^25.8.0",
    "vite": "^8.2.2"
  }
}
